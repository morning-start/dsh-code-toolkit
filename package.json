{
  "name": "@morning-start/dsh-code-toolkit",
  "version": "0.26.1",
  "private": true,
  "type": "module",
  "description": "Five commands for DeepSeek Harness: code review, behavior-preserving simplification, privacy scrubbing, a caption loop, and a PUA protocol. Checks run in the current session by default (add sub for an isolated agent) and write by default (add report for a plan only).",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "code-toolkit",
    "code-review",
    "simplify",
    "privacy",
    "secret-scan",
    "caption",
    "pua",
    "subagent"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "agents",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node evals/run.mjs",
    "eval": "node evals/run.mjs --verbose",
    "case": "node evals/case-setup.mjs",
    "score": "node evals/score.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
