{
  "name": "@morning-start/dsh-code-toolkit",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "A toolkit of isolated-agent passes for DeepSeek Harness: code review, behavior-preserving simplification, and privacy scrubbing (secrets, accounts, local paths) with masked reports. Layered reference material and an evaluation harness included.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "code-toolkit",
    "code-review",
    "simplify",
    "privacy",
    "secret-scan"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "agents",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node evals/run.mjs",
    "eval": "node evals/run.mjs --verbose"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
